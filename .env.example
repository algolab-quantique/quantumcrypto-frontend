# QuantumCrypto frontend — environment template
#
# Copy this file to `.env.local` and adjust if needed:
#
#     cp .env.example .env.local
#
# `.env.local` is git-ignored: it is YOUR machine's config. Never commit it.
# In production these values come from the host instead (Amplify console,
# your server's environment, Vercel project settings, ...), not from a file.
#
# Both variables are NEXT_PUBLIC_*, which means they are baked into the client
# bundle at BUILD time. They are not secrets, and changing them needs a rebuild.

# Where the backend is. The defaults below match the backend's own local setup
# (see the backend repo's "Running Locally"). Use https:// and wss:// in production.
NEXT_PUBLIC_API_URL=http://localhost:8000

# The /ws suffix is REQUIRED: the backend registers WebSocket routes under `ws/`
# (bb84/routing.py), and nginx keys on that same prefix in production to apply the
# WebSocket upgrade headers. Without it, multiplayer silently fails to connect.
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:8000/ws


# ── Optional: test mode ───────────────────────────────────────────────────────
# Lowers the solo photon minimums so you can play a game quickly by hand
# (BB84: default 4 instead of 10 · E91: 4 instead of 10).
#
# DEVELOPMENT ONLY. Uncomment it in YOUR OWN .env.local — that file is
# git-ignored, so your choice affects nobody else and can never reach production.
# Restart the dev server afterwards: Next.js reads env files at startup only.
#
# Leaving it commented out (or absent) = production values. That is the point:
# production is what you get by default, test mode is a deliberate act.
#
# NEXT_PUBLIC_QC_TEST_MODE=true
