# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
.idea
# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — each developer's own machine config, never committed.
# `.env.example` IS tracked: it is the template new contributors copy from.
.env
.env.local
.env*.local
# Amplify's build writes console env vars into .env.production
# (`env | grep -e NEXT_PUBLIC_ >> .env.production`). That happens on the build
# server, but ignore it here so a local run of the same command can never be
# committed by accident.
.env.production
.env.development


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

